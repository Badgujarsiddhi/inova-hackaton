# ScamShield AI - Environment Configuration Template
# Duplicate this file as .env and fill in your credentials

# Gemini API Key (Required for full AI Deep Link & Text Scanning, OCR, and Chatbot)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Session Security Key (Optional)
SECRET_KEY=scamshield-secret-2983

# Local Server Port (Optional, default is 5000)
PORT=5000
